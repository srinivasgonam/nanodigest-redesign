# Form submissions (newsletter, contact, advertise, order requests).
# Point this at any backend exposing POST {url}/newsletter, /contact, /advertise and /orders,
# e.g. the bundled Express API deployed to a Node host: https://your-host.example/api
# If left blank, the deployed static site shows a friendly "not connected" message instead of failing silently.
VITE_FORMS_API_URL=

# Optional: WordPress + nanodigest-backend plugin for form submissions (local development only).
# Local hosts such as http://nano-digest.local are ignored in production builds.
VITE_WORDPRESS_URL=

# Content API: posts, pages, products, WooCommerce store.
# Leave blank to use the local Express proxy in development and nanodigest.in in production.
VITE_CONTENT_API_URL=

# Google AdSense (all optional). Real ads load only when a publisher id AND the matching
# ad-unit id are set, and only after the visitor accepts the cookie notice.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_SIDEBAR=

# Set to "true" to show labelled empty ad spaces (useful for demos). You can also add
# ?ads=preview to any page URL to preview them, and ?ads=off to hide them again.
VITE_SHOW_AD_PLACEHOLDERS=
